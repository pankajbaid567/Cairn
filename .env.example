# Cairn local configuration template (design §4 and §7, Requirement 22;
# free-tier design §6, Requirement 13).
#
# `make env` copies this file to .env, replaces every value that is exactly
# `change-me` with a fresh random secret and writes every `user-provided` value
# as empty. It refuses to overwrite an existing .env. `make env-update` appends
# the keys an existing .env lacks and never changes a line already in it.
# Keep only placeholders here: this file is tracked, .env never is.
#
# Rules for editing this template:
# - A generated secret has the value `change-me`; a credential only the user
#   can supply has the value `user-provided`. Both unquoted, nothing after them.
# - Every variable whose name contains PASSWORD, SECRET, TOKEN or KEY must be
#   `change-me` or `user-provided` (a unit test enforces this).
# - Put comments on their own lines, never after a value.
# - Image tags and digests live in docker-compose.yml, not here.
#
# The host-side values below (CAIRN_DB_HOST=127.0.0.1, the collector on
# 127.0.0.1) are for tools run on the laptop. docker-compose.yml overrides them
# inside the containers (db host `db`, collector `otel-collector`).

# --- Runtime -----------------------------------------------------------------
CAIRN_ENV=local
CAIRN_LOG_LEVEL=INFO

# --- Database connection (api, worker, cairn-db, host tools) -----------------
CAIRN_DB_HOST=127.0.0.1
CAIRN_DB_PORT=5432
CAIRN_DB_NAME=cairn
CAIRN_DB_TIMEOUT_S=2.0
# Sign-in (Amazon Cognito). Leave the pool empty to use only the demo personas locally.
CAIRN_COGNITO_POOL_ID=
CAIRN_COGNITO_CLIENT_ID=
CAIRN_COGNITO_REGION=ap-south-1
CAIRN_AUTH_AUTO_CONFIRM=false
CAIRN_AUDIT_ANCHOR_BUCKET=
CAIRN_APP_DB_USER=cairn_app
CAIRN_DBOS_DB_NAME=cairn_dbos

# Memory limit of the db service (docker-compose.yml default: 1024m). Use 2g
# for the 200,000-row S1 dataset.
CAIRN_DB_MEM_LIMIT=1024m

# --- Database secrets --------------------------------------------------------
# POSTGRES_PASSWORD reaches only the db and db-init services (and the test
# fixtures through the CAIRN_TEST_ADMIN_* settings below). Each runtime role
# password reaches only its own service.
POSTGRES_PASSWORD=change-me
CAIRN_OWNER_DB_PASSWORD=change-me
CAIRN_APP_DB_PASSWORD=change-me
CAIRN_DBOS_DB_PASSWORD=change-me
CAIRN_INGEST_DB_PASSWORD=change-me
CAIRN_EDGE_DB_PASSWORD=change-me

# --- Integration tests -------------------------------------------------------
# The superuser connection that creates the cairn_test_<hex> databases. The
# password is POSTGRES_PASSWORD; there is no separate test password.
CAIRN_TEST_ADMIN_HOST=127.0.0.1
CAIRN_TEST_ADMIN_PORT=5432
CAIRN_TEST_ADMIN_USER=postgres

# --- Worker ------------------------------------------------------------------
# Six-field cron (seconds first). CI uses "*/5 * * * * *" to keep tests short.
CAIRN_HEARTBEAT_CRON="*/30 * * * * *"

# --- Observability -----------------------------------------------------------
# none: no export (core profile). otlp: export to the collector (make up-obs
# sets this for the containers). console: print spans.
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
GRAFANA_ADMIN_PASSWORD=change-me
# --- Database TLS ------------------------------------------------------------
# libpq sslmode for every connection. `prefer` suits the local db; Render and
# .env.neon use verify-full with CAIRN_DB_SSLROOTCERT set to the image's CA
# bundle path, not `system` (FV11; see .env.neon.example).
CAIRN_DB_SSLMODE=prefer
# --- Free-tier emulation profile (make freetier-up) ---------------------------
# Host ports of the ft-db and ft-app services, distinct from the core profile.
CAIRN_FREETIER_DB_PORT=55433
CAIRN_FREETIER_APP_PORT=8010
# Password of the non-superuser cairn_admin role that stands in for the managed
# Postgres owner in the free-tier profile.
CAIRN_MANAGED_ADMIN_PASSWORD=change-me
# --- Proxy shared secret -----------------------------------------------------
# Sent by the Pages Function as x-cairn-proxy-token; the api rejects requests
# without it when set.
CAIRN_PROXY_TOKEN=change-me
# --- Cloudflare Workers AI ---------------------------------------------------
# Only needed when a provider below is workers_ai. Account id: 32 hex digits.
CLOUDFLARE_ACCOUNT_ID=user-provided
CLOUDFLARE_API_TOKEN=user-provided
CAIRN_WORKERS_AI_BASE_URL=https://api.cloudflare.com/client/v4
CAIRN_WORKERS_AI_DAILY_NEURONS=9000
CAIRN_WORKERS_AI_BUDGET_STORE=memory
CAIRN_WORKERS_AI_CONNECT_TIMEOUT_S=5.0
CAIRN_WORKERS_AI_READ_TIMEOUT_S=30.0
CAIRN_WORKERS_AI_MAX_ATTEMPTS=3
# --- Amazon Bedrock (the AWS deployment) -------------------------------------
# No credential here: boto3 uses the AWS credential chain (the EC2 instance role). Select it with
# CAIRN_EMBEDDER / CAIRN_RERANKER / CAIRN_*_PROVIDER = bedrock and Bedrock model ids, for example
# CAIRN_EMBED_MODEL=amazon.titan-embed-text-v2:0 with CAIRN_EMBED_DIM=1024 (256, 512 or 1024),
# CAIRN_ANSWER_MODEL=openai.gpt-oss-120b-1:0 and CAIRN_JUDGE_MODEL=qwen.qwen3-32b-v1:0.
# The daily cap is in US dollars; it is counted in cairn_meta.provider_usage when the store is postgres.
CAIRN_BEDROCK_REGION=ap-south-1
CAIRN_BEDROCK_DAILY_USD=1.0
CAIRN_BEDROCK_BUDGET_STORE=memory
CAIRN_BEDROCK_CONNECT_TIMEOUT_S=5.0
CAIRN_BEDROCK_READ_TIMEOUT_S=60.0
CAIRN_BEDROCK_MAX_ATTEMPTS=3
CAIRN_BEDROCK_REASONING_EFFORT=low
# --- Models ------------------------------------------------------------------
# Local runs and CI use the fake providers, so they need no token. The code
# defaults (workers_ai) are the production defaults.
CAIRN_EMBEDDER=fake
CAIRN_EMBED_MODEL=@cf/baai/bge-small-en-v1.5
CAIRN_EMBED_DIM=384
CAIRN_EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
CAIRN_RERANKER=fake
CAIRN_RERANK_MODEL=@cf/baai/bge-reranker-base
# --- Answer and judge models -------------------------------------------------
CAIRN_ANSWER_PROVIDER=fake
CAIRN_ANSWER_MODEL=@cf/google/gemma-4-26b-a4b-it
CAIRN_JUDGE_PROVIDER=fake
CAIRN_JUDGE_MODEL=@cf/zai-org/glm-4.7-flash
ANTHROPIC_API_KEY=user-provided
OPENAI_API_KEY=user-provided
# --- Phase 1: evidence search -------------------------------------------------
# Session cookie signing key and the HMAC key for audit hashes: at least 32
# characters each, never reused. `make env-update` writes fresh values.
CAIRN_SESSION_SECRET=change-me
CAIRN_AUDIT_HASH_KEY=change-me
CAIRN_INGEST_DB_USER=cairn_ingest
CAIRN_DB_SIZE_GUARD_MB=800
CAIRN_OUTBOX_POLL_S=2.0
# rls_first (RLS plus an explicit ACL predicate in every query) or definer.
CAIRN_ACCESS_MODE=rls_first
CAIRN_VECTOR_STRATEGY=iterative_strict_ef100
CAIRN_DB_POOL_MAX=4
CAIRN_RERANK_MIN_SCORE=0.0
CAIRN_MODEL_CONCURRENCY=2
CAIRN_LLM_OUTPUT_LIMIT=600
CAIRN_LLM_TIMEOUT_S=30.0
CAIRN_COST_BUDGET_NEURONS=1000
CAIRN_COST_BUDGET_USD=1.0
# Laptop tools only: cache embeddings and rerank scores (off, read_write, read_only).
CAIRN_MODEL_CACHE=off
CAIRN_MODEL_CACHE_PATH=var/cache/models/cache.sqlite3
# Demo persona mode (deployment only): see docs/deploy.md.
CAIRN_DEMO_PERSONAS=off
CAIRN_DEMO_LOGIN_PER_MIN=10
CAIRN_DEMO_SEARCH_PER_10MIN=30
CAIRN_DEMO_ANSWER_PER_10MIN=10
CAIRN_DEMO_ANSWERS_PER_DAY=100

# Phase 3 live sync (plan 3.3, 3.4, 3.28). Off until CAIRN_GITHUB_ORG is set.
CAIRN_GITHUB_ORG=user-provided
CAIRN_GITHUB_APP_ID=user-provided
CAIRN_GITHUB_INSTALLATION_ID=user-provided
CAIRN_GITHUB_PRIVATE_KEY=user-provided
CAIRN_GITHUB_WEBHOOK_SECRET=user-provided
CAIRN_GITHUB_USER_MAP=user-provided
CAIRN_SYNC_WAIT_S=20
CAIRN_SYNC_POLL_S=5
CAIRN_RECONCILE_INTERVAL_S=900
CAIRN_ANSWER_CACHE_SIZE=128
CAIRN_ANSWER_CACHE_TTL_S=600
CAIRN_AGENT_CALLS_PER_DAY=500
