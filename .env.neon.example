# Neon bootstrap template (free-tier design §14, Requirement 13).
#
# `make env-neon` (user-run) writes .env.neon from this file: each `change-me`
# becomes a fresh random secret and each `user-provided` value is written
# empty, for the user to fill in from the Neon console (FU2). It refuses to
# overwrite an existing .env.neon. `make remote-init` reads .env.neon.
# Keep only placeholders here: this file is tracked, .env.neon never is.
CAIRN_ENV=demo
# The direct endpoint host, not the -pooler one.
CAIRN_DB_HOST=user-provided
CAIRN_DB_PORT=5432
CAIRN_DB_NAME=cairn
CAIRN_DB_SSLMODE=verify-full
# The Debian CA bundle of the python:3.12.16-slim image that remote-init runs in.
# Not `system`: the OpenSSL bundled with psycopg-binary 3.3.6 has a build-time
# default store path that does not exist in the image, so `system` loads no
# roots and every verify-full connection fails (FV11).
CAIRN_DB_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
CAIRN_DB_ADMIN_USER=neondb_owner
CAIRN_DB_ADMIN_DATABASE=neondb
CAIRN_DB_ADMIN_MODE=managed
# Titan Text Embeddings V2 on Amazon Bedrock: `cairn-db init` makes the embedding column this wide.
CAIRN_EMBED_DIM=1024
# The organisation the importer writes into (1 is the seeded demo organisation). The API never
# sets it: it binds the organisation of each request.
CAIRN_ORG_ID=1
CAIRN_DB_ADMIN_PASSWORD=user-provided
CAIRN_OWNER_DB_PASSWORD=change-me
CAIRN_APP_DB_PASSWORD=change-me
CAIRN_DBOS_DB_PASSWORD=change-me
CAIRN_INGEST_DB_PASSWORD=change-me
CAIRN_EDGE_DB_PASSWORD=change-me
